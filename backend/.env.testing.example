APP_NAME=PGAEV
APP_ENV=testing
APP_KEY=base64:YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE=
APP_DEBUG=true
APP_URL=http://localhost

BCRYPT_ROUNDS=4

LOG_CHANNEL=stderr
LOG_LEVEL=error

# PostgreSQL de pruebas (copia este archivo a .env.testing).
# En GitHub Actions el job pgsql redefine host/puerto/usuario.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=pgaev_test
DB_USERNAME=postgres
DB_PASSWORD=postgres

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null

OPENAI_API_KEY=
PGAEV_REQUIRE_VERIFICATION=false
SANCTUM_EXPIRATION=480
